{
  "name": "pebble-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated multipart-to-JSON webhook proxy",
  "license": "MIT",
  "author": "Joe Hsu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jhsu/pebble-bridge.git"
  },
  "homepage": "https://github.com/jhsu/pebble-bridge#readme",
  "bugs": {
    "url": "https://github.com/jhsu/pebble-bridge/issues"
  },
  "keywords": [
    "webhook",
    "proxy",
    "multipart",
    "hmac",
    "pebble"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run build",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "express": "^5.1.0",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^26.6.2",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2"
  }
}
